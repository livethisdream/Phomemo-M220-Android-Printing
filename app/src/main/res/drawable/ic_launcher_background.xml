<?xml version="1.0" encoding="utf-8"?>
<!--
  The teal-to-green diagonal from the source artwork, as a gradient rather than
  a bitmap so the adaptive icon's background layer stays crisp at any density
  and can be parallaxed by the launcher without artefacts.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#1A9593"
        android:centerColor="#3FACCD"
        android:endColor="#57CFB3"
        android:type="linear" />
</shape>
