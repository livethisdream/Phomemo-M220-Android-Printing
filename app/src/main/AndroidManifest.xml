<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The printer speaks BLE, not Bluetooth Classic, so there is no bond to
      lean on and scanning is mandatory rather than optional.

      On Android 12+ (API 31+) that is BLUETOOTH_SCAN + BLUETOOTH_CONNECT.
      neverForLocation is what keeps a location grant out of it: it promises
      the scan results are not used to derive position, so the system does not
      demand ACCESS_FINE_LOCATION alongside.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Legacy permissions for API 26-30 only. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      Before API 31 there is no neverForLocation escape hatch: a BLE scan
      returns nothing at all without a location grant, however unrelated to
      location the actual intent is. Capped at 30 so Android 12+ never sees it.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
      Deliberately NO android.permission.INTERNET. The label is rendered
      entirely on-device, so the app never touches the network.
    -->

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:label="Label Printer"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Print Label"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- This is what puts the app in Chrome's share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
